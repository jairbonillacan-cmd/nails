# ==============================================================================
# Laikona Nails — Variables de Entorno (Cloudflare Workers + Supabase + R2)
# ==============================================================================
# Sin configurar estas variables, la plataforma arranca automáticamente en
# MODO DEMO LOCAL persistente (.nails-demo-db.json) con simuladores de correo,
# WhatsApp, SMS y Google Calendar para probar todo el flujo al instante.
#
# En producción (Cloudflare Workers), guarda los secretos con:
#   npx wrangler secret put <NOMBRE_SECRETO>
# ==============================================================================

# --- URL pública de tu sitio (usada para links mágicos, OAuth y webhooks) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 0. Secretos obligatorios de producción (genera 32+ bytes aleatorios) ---
ADMIN_SESSION_SECRET=
CLIENT_SESSION_SECRET=
CRON_SECRET=

# --- 1. Supabase Free (PostgreSQL + Auth + Realtime) ---
# Al definir URL + ANON + SERVICE_ROLE la app cambia automáticamente a Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. Cloudflare R2 (Bucket privado para comprobantes SPEI e inspo) ---
# En Workers se usa el binding nativo SALON_MEDIA_BUCKET (wrangler.jsonc).
# Estas llaves S3 habilitan acceso/fallback desde Node, CI o herramientas locales.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=laikona-nails-media
R2_PUBLIC_BASE_URL=

# --- 3. Retención automática 12 meses (avisos 30d y 7d antes de purgar) ---
RETENTION_NOTICE_EMAIL=hola@laikonanails.mx

# --- 4. Google Calendar OAuth 2.0 (Sincronización bidireccional) ---
# Crea credenciales Web en Google Cloud Console con redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_TOKEN=

# --- 5. Resend (Correos transaccionales + invitación .ics + avisos retención) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Laikona Nails <citas@laikonanails.mx>

# --- 6. Meta WhatsApp Cloud API + Coexistence (Plantillas UTILITY es_MX) ---
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_FLOW_ID=
WHATSAPP_MONTHLY_QUOTA=500
WHATSAPP_COEXISTENCE_ENABLED=true
# Overrides opcionales de nombres de plantillas aprobadas en Meta (es_MX UTILITY)
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_REMINDER_24H=
WHATSAPP_TEMPLATE_REMINDER_2H=
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=
WHATSAPP_TEMPLATE_BOOKING_CANCELED=
WHATSAPP_TEMPLATE_WAITLIST_OFFER=

# --- 7. Twilio SMS (Opcional — desactivado por defecto en workflows) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- 8. Pagos / Anticipos en línea (Opcional — arquitectura preparada) ---
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
