# ==============================================================================
# Nails — Variables de Entorno (Plug-and-Play)
# ==============================================================================
# Sin configurar estas variables, la plataforma arranca automáticamente en
# MODO DEMO LOCAL persistente (.nails-demo-db.json) con simuladores de correo,
# WhatsApp, SMS y Google Calendar para probar todo el flujo al instante.
#
# Cuando tengas tus cuentas listas, copia este archivo a `.env.local` y llena
# los bloques que quieras activar.
# ==============================================================================

# --- URL pública de tu sitio (usada para links mágicos, OAuth y webhooks) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 1. Supabase (PostgreSQL + Auth + Realtime + Storage) ---
# Al definir URL + ANON + SERVICE_ROLE la app cambia automáticamente a Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. Google Calendar OAuth 2.0 (Sincronización bidireccional) ---
# Crea credenciales Web en Google Cloud Console con redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_TOKEN=

# --- 3. Resend (Correos transaccionales + invitación .ics) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nails <citas@tudominio.com>

# --- 4. Meta WhatsApp Cloud API (Recordatorios Utility + Booking por WhatsApp) ---
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_FLOW_ID=

# --- 5. Twilio SMS (Opcional — desactivado por defecto en workflows) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- 6. Seguridad para Cron / Upstash QStash (Recordatorios programados) ---
CRON_SECRET=

# --- 7. Pagos / Anticipos en línea (Opcional — arquitectura preparada) ---
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
