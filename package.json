{
  "name": "nails",
  "version": "1.0.0",
  "description": "Nails — Plataforma web brandeada y agenda en tiempo real para salones de uñas con Astryx",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "guardrails": "node scripts/check-guardrails.test.mjs && node scripts/check-guardrails.mjs && node scripts/check-seed-parity.mjs && oxlint --deny-warnings src",
    "deadcode": "knip",
    "test": "vitest run",
    "test:e2e": "node e2e/nails.e2e.mjs",
    "doctor": "node scripts/run-astryx-doctor.mjs",
    "verify": "npm run typecheck && npm run guardrails && npm run deadcode && npm run test && npm run build && npm run doctor",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@stylexjs/stylex": "^0.19.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "aws4fetch": "^1.0.20",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@opennextjs/cloudflare": "^1.20.19",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.11.0",
    "knip": "^6.48.0",
    "oxlint": "^1.95.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
